# Qhub Smart Marketing — environment (all optional in development)
QSM_PORT=8820
QSM_HOST=127.0.0.1
# QSM_DATA_DIR=/path/to/data            # default: ./data (database, media, backups, dev keys)
# QSM_PUBLIC_BASE_URL=https://mk.example.sa   # public URL (Instagram/TikTok pull media; Meta webhooks call it)
# QSM_MAX_UPLOAD_MB=200
# Production: both keys required and different
# QSM_ENV=production
# QSM_SECRET_KEY=<64 random characters>
# QSM_MASTER_KEY=<python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
